# Для ручного запуска скопируй в .env. На сервере install.sh создаёт .env сам, со случайными секретами.
# Пароль Postgres только из букв и цифр: он подставляется в DATABASE_URL.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# prod требует длинный случайный SECRET_KEY (от 32 символов)
APP_ENV=dev
SECRET_KEY=change-me
# На сервере без HTTPS должно быть false, иначе вход не работает
COOKIE_SECURE=false

HTTP_PORT=80

# Админ, которого создаёт install.sh
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# Дополнительные источники для проверки Origin, через запятую. Обычно пусто: Origin сверяется с Host.
ALLOWED_ORIGINS=